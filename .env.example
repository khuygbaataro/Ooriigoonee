# ─────────────────────────────────────────────────────────────
# FACEBOOK / MESSENGER   (developers.facebook.com -> App -> Messenger)
# ─────────────────────────────────────────────────────────────
# Page -> Generate Token (Messenger -> Settings -> Access Tokens)
PAGE_ACCESS_TOKEN=EAAG...
# Өөрөө зохиох санамсаргүй мөр. Webhook тохируулахад ижлийг нь FB дээр бичнэ.
VERIFY_TOKEN=my_super_secret_verify_token_123
# App -> Settings -> Basic -> App Secret (гарын үсэг шалгахад хэрэгтэй)
APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Facebook хуудасны хэрэглэгчийн нэр — «хаана хуваалцах вэ» гэж асуухад
# m.me/<энэ> холбоосыг өгнө. Хоосон бол холбоос үзүүлэхгүй.
PAGE_HANDLE=

# ─────────────────────────────────────────────────────────────
# AI — 2 тусдаа API
# ─────────────────────────────────────────────────────────────
# Claude = анализ, бүрэн тайлан (хэрэглэгч тус бүрд ганц удаа)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-5
# Чат нь олон удаа давтагдана — тайлангаас хямд загвар ашиглаж болно.
# Хоосон бол ANTHROPIC_MODEL-ийг ашиглана.
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max  (өндөр = ухаалаг, үнэтэй, удаан)
ANTHROPIC_EFFORT=medium

# OpenAI = чөлөөт харилцаа / чат
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# ЗАРДЛЫН ГОЛ ТОХИРУУЛГА
#
# Ажил бүр хэр олон удаа давтагдахаас нь хамаарч давхаргаа сонгоно:
#
#   Хүн тутамд НЭГ УДАА  → ANTHROPIC_MODEL (чанар чухал, тоо цөөн)
#     · 10 асуултын анализ    — хүн тутамд 1 дуудлага
#     · бүрэн тайлан          — хүн тутамд 2 дуудлага
#
#   Хүн бүрт ОЛОН ЗУУ    → CHAT_PROVIDER (тоо их, хямд байх ёстой)
#     · яриа бүр              — хүн тутамд хэдэн арав
#     · санах ойн тэмдэглэл   — 6 харилцаа тутамд
#
# ⚠️ Өдөрт 500 хүн × 20 мессеж = 10,000 ярианы дуудлага. Үүнийг үнэтэй
#    загвар дээр тавьбал зардал ХҮНЭЭС биш МЕССЕЖЭЭС хамаарч өснө —
#    яриа чөлөөтэй байх тусам зардал өснө гэсэн үг.
#
# Чанар нь загвараас биш PROMPT-оос ирдэг: хоёр давхарга ижил VOICE,
# ижил профайл, ижил урт хугацааны тэмдэглэлийг хүлээж авна. Хэрэглэгч
# аль нь хариулснаа мэдэхгүй.
#
#   openai — хямд (АНХДАГЧ, санал болгож буй)
#   claude — гүн, гэхдээ хамаагүй үнэтэй
#
# Аль нь ч унавал нөгөө рүү нь автоматаар шилжинэ — бот дуугүй болохгүй.
# ─────────────────────────────────────────────────────────────
CHAT_PROVIDER=openai

# ─────────────────────────────────────────────────────────────
# STORAGE — Upstash Redis (REST API) — ЗААВАЛ
#
# ⚠️ Байхгүй бол in-memory руу унана. Vercel serverless дээр функц бүр өөр
#    контейнерт ажиллаж болох тул хэрэглэгчийн хариулт, profile, ярианы
#    түүх алга болно. Зөвхөн local dev-д тохиромжтой.
#
# ⚠️ Vercel дээр хувьсагчийн НЭР үүсгээд утгыг нь хоосон орхивол байхгүйтэй
#    адил. /api/health дээр REDIS: false гэж харагдана.
#
# Хоёр нэрийн алийг нь ч дэмжинэ (lib/config.js) — аль нэгийг нь бөглөнө:
#   • Vercel Marketplace-ээр холбовол KV_* нэрээр автоматаар орно
#   • Upstash консолоос шууд хуулбал UPSTASH_* нэртэй байна
# ─────────────────────────────────────────────────────────────
KV_REST_API_URL=https://xxx.upstash.io
KV_REST_API_TOKEN=Axxxxxxxx

# ...эсвэл (аль нэг хосыг л бөглөнө):
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=Axxxxxxxx

# ⚠️ rediss:// хэлбэрийн REDIS_URL энэ төсөлд ХЭРЭГГҮЙ — TCP биш, зөвхөн
#    REST API ашигладаг (lib/store.js).

# ─────────────────────────────────────────────────────────────
# ЕРӨНХИЙ
# ─────────────────────────────────────────────────────────────
SITE_URL=https://your-app.vercel.app
# /api/admin, /api/health?deep=1 дуудахад хэрэгтэй нууц түлхүүр
ADMIN_SECRET=change_me_long_random_string

# Нэг хэрэглэгч нэг өдөрт хэдэн мессеж бичиж болох вэ.
#
# ⚠️ 0 буюу хоосон = ХЯЗГААРГҮЙ. Энэ нь анхдагч бөгөөд санал болгож буй утга:
#    яриа бол энэ бүтээгдэхүүний гол үнэ цэн, түүнийг тасалдаг зүйл маш сайн
#    шалтгаангүйгээр байх ёсгүй. Хязгааргүй үед Redis рүү нэмэлт дуудлага ч
#    хийхгүй тул хариулт арай хурдан ирнэ.
#
# ⚠️ Хуучин FREE_CHAT_LIMIT-ийг код УНШИХАА БОЛЬСОН. Тэр нэр төлбөртэй үеийнх
#    («үнэгүй хэрэглэгч 15 мессеж авна»). Vercel дээр үлдсэн бол устгаж болно.
#    Хязгаар тавимаар бол ЗААВАЛ DAILY_CHAT_LIMIT-ийг бичнэ үү.
DAILY_CHAT_LIMIT=0

# Хүн хүнд байдлын тухай ярьвал санал болгох тусламж.
# Тодорхой сэтгэл зүйн тусламжийн утас мэддэг бол энд бичнэ үү.
HELPLINE_TEXT=яаралтай тусламж 103

# ─────────────────────────────────────────────────────────────
# БЭЛЭГ — «өгөө авъяа»
#
# ⚠️ ЭНЭ БОЛ ТӨЛБӨР БИШ. Энэ төсөлд зарах юм БАЙХГҮЙ.
#    Товч тусгал, бүрэн тайлан, хязгааргүй яриа — бүгд эхнээсээ нээлттэй.
#
# Доорх дансны мэдээлэл ЗӨВХӨН дараах нэг тохиолдолд харагдана:
#    хэрэглэгч ӨӨРӨӨ «төлбөртэй юу / яаж дэмжих вэ / данс байна уу» гэж
#    асуусан үед (lib/gift.js → asksAboutGift).
#
# Бот ӨӨРӨӨ мөнгө хэзээ ч дурдахгүй:
#    · AI загварт мөнгө дурдахыг prompt түвшинд ХОРИГЛОСОН (MONEY_SILENCE)
#    · Мөнгөний бүх текст гараар бичигдсэн (lib/gift.js)
#    · Хүнд мөчид (гашуудал, санхүүгийн хүндрэл) ХЭЗЭЭ Ч харуулахгүй
#    · Урт хугацааны дараа, бодит ахиц гарсан үед амьдралд ГАНЦ УДАА
#      зөөлөн сануулж болно — тэр үед ч МӨНГӨ биш, зөвхөн ХУВААЛЦАХЫГ
#
# Бэлэг илгээсэн хүн юу ч НЭМЖ авахгүй — учир нь нэмж өгөх зүйл байхгүй.
# Зөвхөн чин сэтгэлээсээ талархана (lib/gift.js → giftThanks).
#
# Бүхэлд нь унтраах бол: GIFT_ENABLED=0
# ─────────────────────────────────────────────────────────────
GIFT_ENABLED=1
BANK_NAME=Хаан банк
BANK_ACCOUNT=5024703476
BANK_IBAN=MN070005005024703476
BANK_ACCOUNT_NAME=Хуягбаатар

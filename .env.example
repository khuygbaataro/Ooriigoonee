# ─────────────────────────────────────────────────────────────
# FACEBOOK / MESSENGER   (developers.facebook.com -> App -> Messenger)
# ─────────────────────────────────────────────────────────────
# Page -> Generate Token (Messenger -> Settings -> Access Tokens)
PAGE_ACCESS_TOKEN=EAAG...
# Өөрөө зохиох санамсаргүй мөр. Webhook тохируулахад ижлийг нь FB дээр бичнэ.
VERIFY_TOKEN=my_super_secret_verify_token_123
# App -> Settings -> Basic -> App Secret (гарын үсэг шалгахад хэрэгтэй)
APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# AI — 2 тусдаа API
# ─────────────────────────────────────────────────────────────
# Claude = бодолт / анализ / тайлан үүсгэх
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (өндөр = ухаалаг, үнэтэй, удаан)
ANTHROPIC_EFFORT=medium

# OpenAI = чөлөөт харилцаа / чат
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# STORAGE — Upstash Redis (REST API) — ЗААВАЛ
#
# ⚠️ Байхгүй бол in-memory руу унана. Vercel serverless дээр функц бүр өөр
#    контейнерт ажиллаж болох тул хэрэглэгчийн хариулт, profile, paid төлөв
#    алга болно. Зөвхөн local dev-д тохиромжтой.
#
# ⚠️ Vercel дээр хувьсагчийн НЭР үүсгээд утгыг нь хоосон орхивол байхгүйтэй
#    адил. /api/health дээр REDIS: false гэж харагдана.
#
# Хоёр нэрийн алийг нь ч дэмжинэ (lib/config.js) — аль нэгийг нь бөглөнө:
#   • Vercel Marketplace-ээр холбовол KV_* нэрээр автоматаар орно
#   • Upstash консолоос шууд хуулбал UPSTASH_* нэртэй байна
# ─────────────────────────────────────────────────────────────
KV_REST_API_URL=https://xxx.upstash.io
KV_REST_API_TOKEN=Axxxxxxxx

# ...эсвэл (аль нэг хосыг л бөглөнө):
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=Axxxxxxxx

# ⚠️ rediss:// хэлбэрийн REDIS_URL энэ төсөлд ХЭРЭГГҮЙ — TCP биш, зөвхөн
#    REST API ашигладаг (lib/store.js).

# ─────────────────────────────────────────────────────────────
# BUSINESS
# ─────────────────────────────────────────────────────────────
SITE_URL=https://your-app.vercel.app
# Онлайн төлбөрийн холбоос (QPay / Stripe г.м.) — СОНГОЛТТОЙ.
# Хоосон бол зөвхөн банкны шилжүүлэг ашиглана, онлайн товч гарахгүй.
PAYMENT_URL=
# Хэрэглэгчид ХАРУУЛАХ үнийн текст
PRICE_LABEL=19,900₮
# Үнэгүй чатын хязгаар (нэг хэрэглэгч)
FREE_CHAT_LIMIT=15
# /api/admin, /api/health?deep=1 дуудахад хэрэгтэй нууц түлхүүр
ADMIN_SECRET=change_me_long_random_string

# ─────────────────────────────────────────────────────────────
# БАНКНЫ ШИЛЖҮҮЛЭГ
# Хэрэглэгч данс руу шилжүүлээд «Гүйлгээ амжилттай» баримтынхаа зургийг
# чат руу илгээнэ. Claude зургийг уншиж, lib/flow.js доторх judgeReceipt()
# нь дараах 5 нөхцөлийг шалгана:
#   1. Банкны баримт мөн эсэх
#   2. Гүйлгээ амжилттай эсэх
#   3. Хүлээн авагчийн данс BANK_ACCOUNT / BANK_IBAN-тай таарч байгаа эсэх
#   4. Дүн PRICE_AMOUNT-аас багагүй эсэх
#   5. «Гүйлгээний утга» дээрх нэр хэрэглэгчийн Facebook нэртэй таарч байгаа
#      эсэх. lib/names.js нь кирилл/латин галиглалыг тэсвэрлэнэ
#      («Хуягбаатар Очирхуяг» = «khuygbaatar ochirkhuyg»). Facebook профайл
#      татагдаагүй бол ЭНЭ ШАЛГАЛТЫГ АЛГАСНА — эс тэгвээс FB API-ийн түр
#      зуурын алдаа бүх төлбөрийг зогсооно.
# Тавуулаа таарвал төлбөр баталгаажиж, тайлан шууд илгээгдэнэ.
#
# ⚠️ Нэг баримтыг дахин ашиглахаас зургийн sha256 болон гүйлгээний дугаараар
#    хамгаална. Шалгалт бүр Redis-д payproof:<psid>:<ts> түлхүүрээр хадгалагдана.
# ─────────────────────────────────────────────────────────────
BANK_NAME=Хаан банк
BANK_ACCOUNT=5556563179
BANK_IBAN=MN570005005556563179
# Данс эзэмшигчийн нэр — шилжүүлэг хийхэд хэрэглэгч харна
BANK_ACCOUNT_NAME=ХОНГОРЗУЛ БАТХИШИГ
# Баримт дээрх дүнг шалгах доод хэмжээ (зөвхөн тоо). 0 бол дүн шалгахгүй.
PRICE_AMOUNT=19900
